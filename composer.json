{
    "name": "rootstuff/laravel-ops-mcp",
    "description": "A read-only MCP server inside your Laravel app so your agent can read the logs, queues, failed jobs, scheduler and vitals without SSH.",
    "keywords": ["laravel", "mcp", "ops", "logs", "horizon", "queue", "scheduler", "claude", "agent"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Adam Balée",
            "email": "adam@rootstuff.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/mcp": "^1.0",
        "illuminate/console": "^11.45.3|^12.41.1|^13.0",
        "illuminate/contracts": "^11.45.3|^12.41.1|^13.0",
        "illuminate/database": "^11.45.3|^12.41.1|^13.0",
        "illuminate/http": "^11.45.3|^12.41.1|^13.0",
        "illuminate/queue": "^11.45.3|^12.41.1|^13.0",
        "illuminate/support": "^11.45.3|^12.41.1|^13.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Rootstuff\\OpsMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rootstuff\\OpsMcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rootstuff\\OpsMcp\\OpsMcpServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
